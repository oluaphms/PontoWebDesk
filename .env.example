# ============================================
# PontoWebDesk — template de variáveis (raiz)
# ============================================
#
# Ambientes oficiais:
#   development → .env.development  (+ .env.development.local opcional)
#   production  → .env.production   (+ .env.production.local / Vercel env)
#
# Copie este arquivo como referência. Não coloque segredos reais aqui.
# Segredos locais: use *.local (gitignored).
#
# Frontend (Vite): apenas chaves VITE_* entram no bundle.
# Backend (API): veja backend/.env.example e docs/environments.md
#
# ============================================

# --- Ambiente ---
# development | production (espelhado também em VITE_APP_ENV)
VITE_APP_ENV=development

# Modo de implantação (opcional). Se omitido, deriva do ambiente:
#   development / API local → LOCAL
#   production remota → SAAS
# Valores: SAAS | LOCAL | HYBRID
# VITE_DEPLOYMENT_MODE=LOCAL

# Licença (opcional; omitir = full, sem restrição — compatível com o produto atual)
# VITE_LICENSE_TIER=full
# VITE_LICENSE_KEY=
# JSON (ou base64 JSON) com claims: type, tier, plan, expiresAt, modules, limits, etc.
# VITE_LICENSE_PAYLOAD={"tier":"standard","plan":"Standard","expiresAt":null,"limits":{"maxUsers":200,"maxDevices":20,"maxCompanies":5}}

# Provider de dados: LOCAL_API (padrão) | SUPABASE (legado / não implementado no FE)
VITE_DATA_PROVIDER=LOCAL_API

# --- API (frontend) ---
# Development local: http://localhost:3000/api
# Production:        https://api.phmsdev.com.br/api
VITE_API_URL=http://localhost:3000/api
# Alias legado (opcional)
# VITE_LOCAL_API_BASE_URL=http://localhost:3000

# URL pública do app (auth/redirect)
# VITE_APP_URL=http://localhost:3010

# --- Supabase (apenas se VITE_DATA_PROVIDER=SUPABASE no futuro) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- Backend Master Control Plane (não prefixar com VITE_) ---
# Persistência do Painel Master: postgres em runtime normal; memory só em testes.
# MASTER_PERSISTENCE=postgres
# MASTER_JWT_SECRET=
# DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# --- Observabilidade (opcional) ---
# VITE_SENTRY_DSN=

# --- Feature flags operacionais (opcional) ---
# VITE_OP_GEO_CONSENSUS_ENABLED=false
# VITE_OP_NATIVE_GPS_ENABLED=false
# VITE_OP_REALTIME_COORDINATOR_ENABLED=true
# Polling HTTP (LOCAL_API) — substitui Supabase Realtime / WebSocket
# VITE_LOCAL_REALTIME_POLL_MS=12000
# VITE_OP_GEO_FORENSICS_ENABLED=true
# VITE_OP_OPERATIONAL_INCIDENTS_ENABLED=false
# VITE_OP_SCALE_MODE_ENABLED=false
# VITE_OP_COS_STRICT_MODE=false
# VITE_OP_MAP_STALE_BLOCK_ENABLED=true
# VITE_OP_GEO_HEALTH_GUARD_ENABLED=true

# audit_logs inclui tenant_id? (omitir = detecção automática)
# Schema Guard — defina explicitamente em todo ambiente (evita falso crítico no boot).
VITE_HAS_AUDIT_LOGS_TENANT_ID=false

# --- Serverless / agente (Node; NÃO prefixar com VITE_) ---
# API_KEY=
# CRON_SECRET=
# TIMESTAMP_SECRET_KEY=
# REP_API_KEY=
# CLOCK_AGENT_API_URL=http://localhost:3000
# CLOCK_AGENT_API_KEY=
