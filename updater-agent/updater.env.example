# Control Plane (Master) — HTTPS em produção
PWD_CONTROL_PLANE_URL=https://master.seudominio.com

# Token emitido uma vez pelo Master:
# POST /api/master/updates/installations/:id/agent-token
PWD_AGENT_TOKEN=uag_substitua_pelo_token

# Canal e versão
PWD_CHANNEL=stable
# PWD_CURRENT_VERSION=1.0.0
# PWD_VERSION_FILE=C:\PontoWebDesk\version.txt

# Diretórios
PWD_INSTALL_DIR=C:\PontoWebDesk
# PWD_STAGING_DIR=C:\PontoWebDesk\.updater\staging
# PWD_BACKUP_DIR=C:\PontoWebDesk\.updater\backups

# Health local pós-restart
PWD_HEALTH_URL=http://127.0.0.1:3001/api/health/ready

# Serviços Windows a reiniciar (vírgula)
PWD_SERVICE_NAMES=PontoWebDesk

# Loop
PWD_POLL_INTERVAL_MS=60000
PWD_HEALTH_TIMEOUT_MS=120000

# Assinatura (opcional; SHA-256 do artefato é sempre obrigatório)
# PWD_SIGNER_HMAC_KEY=
# PWD_SIGNER_PUBLIC_KEY=
# PWD_SIGNER_KEY_ID=

# Log
# PWD_LOG_FILE=C:\PontoWebDesk\logs\updater.jsonl
PWD_AGENT_VERSION=1.0.0
