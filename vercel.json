{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/process-daily-time",
      "destination": "/api/jobs/process-daily-time"
    },
    {
      "source": "/api/rep/devices/:id/sync-status",
      "destination": "/api/rep/sync-status?device_id=:id&lite=1"
    },
    {
      "source": "/api/web-punches",
      "destination": "/api/punch"
    },
    {
      "source": "/api/punches/batch",
      "destination": "/api/punch"
    }
  ],
  "routes": [
    {
      "src": "^/api/process-daily-time/?$",
      "dest": "/api/jobs/process-daily-time"
    },
    {
      "src": "^/api/lgpd(?:/(.*))?$",
      "dest": "/api/operational/lgpd/$1"
    },
    {
      "src": "^/api/mirror-insert-time-record$",
      "dest": "/api/operational/mirror-insert-time-record"
    },
    {
      "src": "^/api/rep/devices/([^/]+)/sync-status/?$",
      "dest": "/api/rep/sync-status?device_id=$1&lite=1"
    },
    {
      "src": "^/api/web-punches/?$",
      "dest": "/api/punch"
    },
    {
      "src": "^/api/punches/batch/?$",
      "dest": "/api/punch"
    },
    {
      "src": "^/api/(?!rep(?:/|$))(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/((?!api/)(?!.*\\..*).*)$",
      "dest": "/index.html"
    }
  ]
}
