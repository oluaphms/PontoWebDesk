{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.phmsdev.com.br https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/process-daily-time",
      "destination": "/api/jobs/process-daily-time"
    },
    {
      "source": "/api/rep/devices/:id/sync-status",
      "destination": "/api/rep/sync-status?device_id=:id&lite=1"
    },
    {
      "source": "/api/web-punches",
      "destination": "/api/punch"
    },
    {
      "source": "/api/punches/batch",
      "destination": "/api/punch"
    }
  ],
  "routes": [
    {
      "src": "^/api/process-daily-time/?$",
      "dest": "/api/jobs/process-daily-time"
    },
    {
      "src": "^/api/lgpd(?:/(.*))?$",
      "dest": "/api/operational/lgpd/$1"
    },
    {
      "src": "^/api/mirror-insert-time-record$",
      "dest": "/api/operational/mirror-insert-time-record"
    },
    {
      "src": "^/api/rep/devices/([^/]+)/sync-status/?$",
      "dest": "/api/rep/sync-status?device_id=$1&lite=1"
    },
    {
      "src": "^/api/web-punches/?$",
      "dest": "/api/punch"
    },
    {
      "src": "^/api/punches/batch/?$",
      "dest": "/api/punch"
    },
    {
      "src": "^/api/(?!rep(?:/|$))(.*)$",
      "dest": "/api/$1"
    },
    {
      "src": "^/((?!api/)(?!.*\\..*).*)$",
      "dest": "/index.html"
    }
  ]
}
