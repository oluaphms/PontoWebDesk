# Copie para `rep-agent-prod-env.ps1` (gitignore), edite e execute:
#   . .\scripts\rep-agent-prod-env.ps1
#   npm run rep:agent
#
# Bloco equivalente no PowerShell (substitua os placeholders por valores reais fora do git):

$env:REP_AGENT_SKIP_DOTENV     = "1"
$env:REP_SAAS_URL              = "https://pontowebdesk.vercel.app"
$env:API_KEY                   = "CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32"
$env:REP_DEVICE_IP             = "192.168.1.19"
# Se http:80 devolver HTTP 301, use https:443 + INSECURE_TLS ou deixe o script seguir o redirect (REP_INSECURE_TLS=1).
$env:REP_DEVICE_SCHEME         = "https"
$env:REP_DEVICE_PORT           = "443"
$env:REP_INSECURE_TLS         = "1"
$env:REP_COMPANY_ID            = "a145b0cd-76f4-4dc8-b50c-02b0c9bfe24b"
$env:REP_DEVICE_LOGIN          = "admin"
$env:REP_DEVICE_PASSWORD       = "CHANGE_ME_DEVICE_PASSWORD"
# $env:REP_AFD_PORTARIA_671    = "1"
# $env:REP_DEVICE_ID           = ""

Write-Host "[rep-agent prod] Edite API_KEY e REP_DEVICE_PASSWORD fora do git, depois: npm run rep:agent" -ForegroundColor Yellow
