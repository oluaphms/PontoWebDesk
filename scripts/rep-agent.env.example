# === PRODUÇÃO (serviço Windows / rep-agent.exe) ===
# Use C:\ProgramData\PontoWebDesk\config.json — veja installer/config.template.json
# O .exe NÃO lê este arquivo; apenas desenvolvimento com `npm run rep:agent`.
#
# Produção: URL pública do SaaS (NÃO use localhost no agente instalado na empresa)
REP_SAAS_URL=https://pontowebdesk.vercel.app
# REP_PRODUCTION_MODE=1  # no servidor (agent-config → incremental)
# REP_RECEIVE_SCOPE=incremental
# REP_INGEST_FROM_DATE=2026-01-01
# REP_INGEST_END_DATE=2026-05-19
# REP_FORCE_MODE=1
API_KEY=CHANGE_ME_WITH_A_STRONG_KEY
REP_DEVICE_IP=192.168.1.19
REP_DEVICE_SCHEME=https
REP_DEVICE_PORT=443
REP_INSECURE_TLS=1
REP_COMPANY_ID=00000000-0000-0000-0000-000000000000
REP_DEVICE_LOGIN=admin
REP_DEVICE_PASSWORD=CHANGE_ME
# REP_AFD_PORTARIA_671=1
# REP_DEVICE_ID=
REP_AGENT_LOOP=1
REP_AGENT_INTERVAL_MS=60000
# Poll de comandos do painel (test_connection) — anti-egress; nunca < 30s em produção.
REP_COMMAND_POLL_MIN_MS=30000
REP_COMMAND_POLL_MAX_MS=60000
REP_COMMAND_SKIP_IF_OFFLINE_MS=180000
REP_HEARTBEAT_INTERVAL_MS=300000
REP_LOW_COST_MODE=1
REP_ULTRA_LOW_COST=0
REP_MIN_SEND_BATCH=10
REP_ENABLE_COMMANDS=0
REP_BATCH_SYNC_INTERVAL_MS=120000
REP_BATCH_SIZE=50
# REP_AGENT_DB_PATH=C:\ProgramData\PontoWebDesk\agent.db
REP_COMMAND_EXEC_TIMEOUT_MS=10000
# REP_DEBUG=1
REP_AGENT_VERSION=1.2.0
REP_DEVICE_TIMEZONE_OFFSET=-03:00
# Cada batida envia punch_hash (SHA-256) — reenvio é idempotente no servidor.
# Go-live automático (padrão): 1ª execução = só hoje; depois = incremental (state/agent-meta.json).
# REP_FORCE_MODE=1                # desliga auto-config; usa REP_RECEIVE_SCOPE / REP_INGEST_FROM_DATE abaixo.
# REP_RECEIVE_SCOPE=incremental   # só com REP_FORCE_MODE=1
# REP_RECEIVE_SCOPE=today_only      # só com REP_FORCE_MODE=1
# REP_INGEST_FROM_DATE=2026-05-18 # só com REP_FORCE_MODE=1 (data futura = erro)
