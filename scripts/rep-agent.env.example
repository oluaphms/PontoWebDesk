REP_AGENT_SKIP_DOTENV=1
REP_SAAS_URL=https://pontowebdesk.vercel.app
API_KEY=CHANGE_ME_WITH_A_STRONG_KEY
REP_DEVICE_IP=192.168.1.19
REP_DEVICE_SCHEME=https
REP_DEVICE_PORT=443
REP_INSECURE_TLS=1
REP_COMPANY_ID=00000000-0000-0000-0000-000000000000
REP_DEVICE_LOGIN=admin
REP_DEVICE_PASSWORD=CHANGE_ME
# REP_AFD_PORTARIA_671=1
# REP_DEVICE_ID=
REP_AGENT_LOOP=1
REP_AGENT_INTERVAL_MS=60000
REP_DEVICE_TIMEZONE_OFFSET=-03:00
# Cada batida envia punch_hash (SHA-256) — reenvio é idempotente no servidor.
# Go-live automático (padrão): 1ª execução = só hoje; depois = incremental (state/agent-meta.json).
# REP_FORCE_MODE=1                # desliga auto-config; usa REP_RECEIVE_SCOPE / REP_INGEST_FROM_DATE abaixo.
# REP_RECEIVE_SCOPE=incremental   # só com REP_FORCE_MODE=1
# REP_RECEIVE_SCOPE=today_only      # só com REP_FORCE_MODE=1
# REP_INGEST_FROM_DATE=2026-05-18 # só com REP_FORCE_MODE=1 (data futura = erro)
