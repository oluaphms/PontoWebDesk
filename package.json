{
  "name": "Pontowebdesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "preview:3010": "vite preview --port 3010",
    "test": "vitest",
    "lint": "eslint index.tsx src components --max-warnings 745",
    "lint:pages": "eslint src/pages --max-warnings 506",
    "lint:lib": "eslint src --ignore-pattern \"src/pages/**\" --max-warnings 210",
    "lint:ui": "eslint components index.tsx --max-warnings 29",
    "test:run": "vitest run",
    "test:chaos": "vitest run src/testing/chaos",
    "lint:architecture": "node scripts/architecture-lint.mjs",
    "lint:depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "ci:self-heal": "node scripts/self-healing-checks.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "audit:dependency-graph": "node scripts/dependency-graph-audit.mjs",
    "generate:architecture-docs": "node scripts/generate-architecture-docs.mjs",
    "generate:telemetry": "node scripts/engineering-telemetry.mjs",
    "scaffold:context": "node scripts/generate-context.mjs",
    "scaffold:service": "node scripts/generate-service.mjs",
    "scaffold:contract": "node scripts/generate-contract.mjs",
    "scaffold:operational-module": "node scripts/generate-operational-module.mjs",
    "rep:agent": "node scripts/rep-agent.mjs",
    "build:agent": "node scripts/build-rep-agent-exe.mjs",
    "clock-sync-agent": "tsx agent/index.ts"
  },
  "bin": "scripts/rep-agent.mjs",
  "pkg": {
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "@sentry/react": "^8.38.0",
    "@tanstack/react-query": "^5.99.0",
    "@types/crypto-js": "^4.2.2",
    "better-sqlite3": "^12.9.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.35.1",
    "i18next": "^24.2.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "leaflet": "^1.9.4",
    "list": "^2.0.19",
    "lucide-react": "^0.562.0",
    "luxon": "^3.7.2",
    "mammoth": "^1.12.0",
    "motion-utils": "^12.36.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.5.207",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^15.1.2",
    "react-is": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.0.0",
    "remark-gfm": "^4.0.1",
    "use-context-selector": "^2.0.0",
    "use-sync-external-store": "^1.2.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^16.9.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^25.0.1",
    "pkg": "^5.8.1",
    "postcss": "^8.4.47",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
