# ============================================
# PontoWebDesk API — PostgreSQL (Hostinger VPS)
# ============================================
# Ambientes oficiais: ver docs/environments.md
# Templates por modo:
#   backend/.env.development
#   backend/.env.production
# Copie para backend/.env e preencha com dados reais.
# NUNCA commite o arquivo .env real.
#
# ============================================
# PontoWebDesk API — PostgreSQL (Hostinger VPS)
# ============================================
# Copie para backend/.env e preencha com os dados do painel Hostinger.
# NUNCA commite o arquivo .env real.

# Porta da API Node (PM2 / systemd)
PORT=3000

# Modo de implantação (opcional). Se omitido:
#   development / DB local → LOCAL
#   NODE_ENV=production → SAAS
# Valores: SAAS | LOCAL | HYBRID
# DEPLOYMENT_MODE=LOCAL

# Licença (opcional; omitir = full, sem restrição)
# LICENSE_TIER=full
# LICENSE_KEY=
# JSON (ou base64 JSON) com claims — sem banco / sem cobrança nesta fase
# LICENSE_PAYLOAD={"tier":"standard","plan":"Standard","expiresAt":null,"limits":{"maxUsers":200,"maxDevices":20,"maxCompanies":5}}

# API Master (Fase 19+) — bootstrap / auth Master (separado do login das empresas)
# Header: X-Master-Key: <valor>
# MASTER_API_KEY=
# MASTER_JWT_SECRET=change-me-master-only
# MASTER_JWT_EXPIRES_IN=8h
# MASTER_REFRESH_EXPIRES_IN=7d
# MASTER_MAX_SESSIONS=5
# Dois Owners independentes. Use e-mails e senhas diferentes.
# As senhas servem somente para criar contas ausentes; não são sobrescritas no restart.
# MASTER_OWNER_1_EMAIL=owner1@seudominio.com
# MASTER_OWNER_1_PASSWORD=change-me-owner-1-min-8-chars
# MASTER_OWNER_1_NAME=Owner 1
# MASTER_OWNER_2_EMAIL=owner2@seudominio.com
# MASTER_OWNER_2_PASSWORD=change-me-owner-2-min-8-chars
# MASTER_OWNER_2_NAME=Owner 2
# Compatibilidade legada do slot 1: MASTER_OWNER_EMAIL/PASSWORD/NAME
# Founder permanente (não usar e-mail como regra de proteção):
# MASTER_OWNER_1_IS_FOUNDER=false
# MASTER_OWNER_2_IS_FOUNDER=true
# Idealizador (conta is_founder protegida): use MASTER_OWNER_*_IS_FOUNDER ou MASTER_FOUNDER_USER_IDS.
# Em produção o idealizador do PontoWebDesk é Paulo Henrique (paulohmorais@hotmail.com) — ver migração 038.
# MASTER_FOUNDER_USER_IDS=mu_xxxxxxxx,mu_yyyyyyyy
# Persistência do Painel Master: memory (default/testes) | postgres
# Persistência do control plane Master (billing, tenants, auth Master).
# Local Docker: use postgres para que exclusões de pagamento sobrevivam a refresh/restart.
# MASTER_PERSISTENCE=memory
MASTER_PERSISTENCE=postgres
# Seed demo de licenças (Demo SAAS/LOCAL/HYBRID/Bloqueada). Default: desligado.
# Sem isto, exclusão de licenças é permanente (não recria no list/restart).
# MASTER_LICENSE_DEMO_SEED=true
# MASTER_DEPLOYMENT_DEMO_SEED=true
# MASTER_BILLING_DEMO_SEED=true
# Fase 6.4 / 6.5 — processador de avisos + inadimplência (somente persistence=postgres)
# MASTER_FINANCE_AUTOMATION_ENABLED=true
# MASTER_FINANCE_AUTOMATION_INTERVAL_MS=300000
# Opcional: webhook HTTP para e-mail/SMS ao admin da empresa (senão entrega via log)
# MASTER_NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/master-notify

# PostgreSQL na Hostinger
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Docker (projeto postgresql-ccqe no hPanel):
#   - API na mesma VPS → HOST=127.0.0.1 e PORTA = porta publicada no Compose (souvent 5432)
#   - Credenciais → variáveis POSTGRES_* no painel Docker / Compose
#
# Opção A — variáveis separadas (recomendado se a senha tiver @ ou caracteres especiais)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=admin
# PGPASSWORD=CHANGE_ME
# PGDATABASE=pontowebdesk
#
# Dev local com PostgreSQL Docker (ex.: container pg16-restore em localhost:55432):
#   ver backend/.env.development → PGHOST=127.0.0.1 PGPORT=55432
#   DATABASE_URL=postgres://postgres@127.0.0.1:55432/pontowebdesk
#
# Opção B — URL (senha com @ → codifique %40)
# DATABASE_URL=postgresql://admin:Admin%40123456@127.0.0.1:5432/pontowebdesk
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Pool PostgreSQL — sob SaaS multi-tenant (REP/promote/attendance) preferir 20–40
# alinhado ao max_connections do Postgres. Override: PG_POOL_MAX=30
# PG_POOL_MAX=20

# Diagnóstico REP (4 COUNTs extras no path de ingest) — off em produção por padrão no código.
# REP_PIPELINE_DIAG=1

# Pós-ingest async: promote + recalc em background (libera timeout HTTP). Default sync = compat local.
# Em SaaS/produção com alto volume REP/AFD: REP_POST_INGEST_ASYNC=1
# REP_POST_INGEST_ASYNC=1

# Cap da janela GET /api/attendance/period (dias civis inclusivos). Default 62.
# ATTENDANCE_PERIOD_MAX_DAYS=62
# ATTENDANCE_PERIOD_MAX_CHUNKS=16

# Logar SQL/params da data API (LGPD/volume) — só para debug pontual.
# LOG_DATA_SQL=1

# Migração de dados Supabase → VPS (scripts/data-migration/)
# Connection string DIRECT (porta 5432), não pooler 6543
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres

# SSL (recomendado se o host não for localhost)
# DATABASE_SSL=true

# JWT para login /api/auth/login (gere: openssl rand -hex 32)
JWT_SECRET=generate_strong_random_key_here
# Validade do token — alinhar com session_timeout_minutes do frontend (ex.: 2h)
JWT_EXPIRES_IN=2h

# Chave mestre AES-256-GCM para credenciais de dispositivos (gere: openssl rand -base64 32)
DEVICE_CREDENTIALS_MASTER_KEY=base64_generate_32_bytes_here

# Rate limiting distribuído (use Redis OU Upstash Redis)
# REDIS_URL=redis://default:CHANGE_ME@localhost:6379
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# Produção falha fechado sem Redis/Upstash.
# RATE_LIMIT_REDIS_REQUIRED=true

# ETAPA 3 — evidências do checklist Master (/master/security)
# PENTEST_LAST_OK_AT=2026-07-18T00:00:00.000Z
# PENTEST_REPORT_URL=
# BACKUP_LAST_OK_AT=
# BACKUP_EVIDENCE_URL=
# RESTORE_LAST_OK_AT=
# RESTORE_EVIDENCE_URL=
# DATA_ENCRYPTION_KEY=
# MFA_ENABLED=false

# Fase 23B — exigir assinatura digital ao publicar release (além de SHA-256)
# MASTER_UPDATE_REQUIRE_SIGNATURE=false

# Provider real de segredos para rotação/revogação
# SECRET_PROVIDER=vault|doppler|onepassword-connect
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=CHANGE_ME
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PREFIX=pontowebdesk
# DOPPLER_TOKEN=CHANGE_ME
# DOPPLER_PROJECT=pontowebdesk
# DOPPLER_CONFIG=prd
# OP_CONNECT_HOST=https://op-connect.example.com
# OP_CONNECT_TOKEN=CHANGE_ME
# OP_CONNECT_VAULT_ID=CHANGE_ME

# Revalidar role/company no DB a cada request (recomendado: true)
AUTH_REVALIDATE_DB=true

# Desativar POST/PATCH/DELETE em /api/data (Sprint 4 — menor privilégio)
# Em produção o default já é false; use true apenas se ainda depender de writes genéricos.
# DATA_API_WRITES_ENABLED=false

# RLS no Postgres da VPS (segunda linha de defesa — opt-in)
# Checklist antes de VPS_RLS_ENFORCED=true:
#  1) Aplicar backend/db/migrations/016_vps_rls_tenant_isolation.sql
#  2) Aplicar backend/db/migrations/017_vps_rls_fail_closed.sql (ELSE deny sem company)
#  3) Confirmar set_config app.current_company_id no pool (tenantRls.ts)
#  4) Smoke: login admin, list /api/employees, batida REP, /api/data/time_records
#  5) Smoke cross-tenant: token empresa A não lê dados empresa B
#  6) Em NODE_ENV=production, a API loga WARN se RLS estiver off
# Development local: manter false (default).
# Produção (após smoke): VPS_RLS_ENFORCED=true
# VPS_RLS_ENFORCED=true

# Autenticação REP — bridge token global legado (opt-out)
# REP_BRIDGE_LEGACY_ENABLED=false

# Credenciais do seed inicial (npm run db:seed)
# SEED_ADMIN_EMAIL=admin@local.test
# SEED_ADMIN_PASSWORD=SenhaForte#1234
# SEED_COMPANY_NAME=Empresa Demo
# SEED_COMPANY_SLUG=empresa-demo
# SEED_COMPANY_ID=<uuid ou id de public.companies> — omitir para usar a 1ª empresa do banco

# Origens permitidas no CORS (frontend), separadas por vírgula (sem espaços extras)
# Produção + dev local:
# CORS_ORIGINS e CORS_ALLOWED_ORIGINS são aceitos.
CORS_ORIGINS=https://pontowebdesk.vercel.app,https://pontowebdesk.com.br,https://www.pontowebdesk.com.br,http://localhost:3010,http://localhost:5173

# URL do frontend (redirect do e-mail de recuperação de senha e link do convite Master)
# FRONTEND_URL=http://localhost:3010
# APP_URL=http://localhost:3010
# Convite Master (opcional; se vazio, usa APP_URL / FRONTEND_URL)
# MASTER_FIRST_ACCESS_APP_URL=http://localhost:3010

# Supabase Auth — obrigatório para POST /api/auth/reset-password e /api/auth/recovery/complete
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_ANON_KEY=eyJ...
