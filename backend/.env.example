# ============================================
# PontoWebDesk API — PostgreSQL (Hostinger VPS)
# ============================================
# Copie para backend/.env e preencha com os dados do painel Hostinger.
# NUNCA commite o arquivo .env real.

# Porta da API Node (PM2 / systemd)
PORT=3000

# PostgreSQL na Hostinger
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Docker (projeto postgresql-ccqe no hPanel):
#   - API na mesma VPS → HOST=127.0.0.1 e PORTA = porta publicada no Compose (souvent 5432)
#   - Credenciais → variáveis POSTGRES_* no painel Docker / Compose
#
# Opção A — variáveis separadas (recomendado se a senha tiver @ ou caracteres especiais)
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=admin
# PGPASSWORD=CHANGE_ME
# PGDATABASE=pontowebdesk
#
# Opção B — URL (senha com @ → codifique %40)
# DATABASE_URL=postgresql://admin:Admin%40123456@127.0.0.1:5432/pontowebdesk
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Migração de dados Supabase → VPS (scripts/data-migration/)
# Connection string DIRECT (porta 5432), não pooler 6543
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@db.[ref].supabase.co:5432/postgres

# SSL (recomendado se o host não for localhost)
# DATABASE_SSL=true

# JWT para login /api/auth/login (gere: openssl rand -hex 32)
JWT_SECRET=generate_strong_random_key_here
# Validade do token — alinhar com session_timeout_minutes do frontend (ex.: 2h)
JWT_EXPIRES_IN=2h

# Chave mestre AES-256-GCM para credenciais de dispositivos (gere: openssl rand -base64 32)
DEVICE_CREDENTIALS_MASTER_KEY=base64_generate_32_bytes_here

# Rate limiting distribuído (use Redis OU Upstash Redis)
# REDIS_URL=redis://default:CHANGE_ME@localhost:6379
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# Produção falha fechado sem Redis/Upstash.
# RATE_LIMIT_REDIS_REQUIRED=true

# Provider real de segredos para rotação/revogação
# SECRET_PROVIDER=vault|doppler|onepassword-connect
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=CHANGE_ME
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PREFIX=pontowebdesk
# DOPPLER_TOKEN=CHANGE_ME
# DOPPLER_PROJECT=pontowebdesk
# DOPPLER_CONFIG=prd
# OP_CONNECT_HOST=https://op-connect.example.com
# OP_CONNECT_TOKEN=CHANGE_ME
# OP_CONNECT_VAULT_ID=CHANGE_ME

# Revalidar role/company no DB a cada request (recomendado: true)
AUTH_REVALIDATE_DB=true

# Desativar POST/PATCH/DELETE em /api/data (Sprint 4 — menor privilégio)
# DATA_API_WRITES_ENABLED=false

# Credenciais do seed inicial (npm run db:seed)
# SEED_ADMIN_EMAIL=admin@local.test
# SEED_ADMIN_PASSWORD=SenhaForte#1234
# SEED_COMPANY_NAME=Empresa Demo
# SEED_COMPANY_SLUG=empresa-demo
# SEED_COMPANY_ID=<uuid ou id de public.companies> — omitir para usar a 1ª empresa do banco

# Origens permitidas no CORS (frontend), separadas por vírgula (sem espaços extras)
# Produção + dev local:
# CORS_ORIGINS e CORS_ALLOWED_ORIGINS são aceitos.
CORS_ORIGINS=https://pontowebdesk.vercel.app,https://pontowebdesk.com.br,https://www.pontowebdesk.com.br,http://localhost:3010,http://localhost:5173

# Supabase Auth — obrigatório para POST /api/auth/recovery/complete (redefinição de senha)
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_ANON_KEY=eyJ...
